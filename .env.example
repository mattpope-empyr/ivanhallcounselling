# Copy to .env.local and fill in. Restart `npm run dev` after changing.

# Calendly scheduling link for the Availability / diary page.
# Create an event type in Calendly, copy its public link, and paste it here.
# When set, the Availability page shows the live Calendly calendar automatically.
# Example: NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/ivan-hall/free-consultation
NEXT_PUBLIC_CALENDLY_URL=

# Form handling endpoint for booking/contact forms (optional).
# If blank, forms fall back to opening the visitor's email app (mailto:).
# Supports Formspree (https://formspree.io) and Web3Forms endpoints.
# Example: NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
NEXT_PUBLIC_FORM_ENDPOINT=
